# Copy to .env before `docker compose up`. Compose refuses to start without
# JWT_SECRET, deliberately: the in-code default is fine for tests and is not
# safe anywhere else.
#
#   openssl rand -hex 32

JWT_SECRET=

POSTGRES_PASSWORD=change-me
MINIO_USER=sunrise
MINIO_PASSWORD=change-me-too

# Must match the dashboard's exact origin or the browser blocks every call.
CORS_ORIGINS=http://localhost:5173

# 12 is the default. Only the test suite lowers this, to 4.
BCRYPT_ROUNDS=12
