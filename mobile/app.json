{
  "expo": {
    "name": "Sunrise School",
    "slug": "sunrise-school",
    "scheme": "sunrise",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "edu.sunrisepublic.app"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#5B4BE0",
          "resizeMode": "contain"
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "runtimeVersion": {
      "policy": "sdkVersion"
    }
  }
}
